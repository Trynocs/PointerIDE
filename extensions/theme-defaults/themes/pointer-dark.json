			}
		},
		{
			"scope": "variable",
			"settings": {
				"foreground": "#D8D8D8"
			}
		},
		{
			"scope": "variable.other",
			"settings": {
				"foreground": "#D8D8D8"
			}
		},
		{
			"scope": "invalid.broken",
			"settings": {
				"foreground": "#D8D8D8",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid.deprecated",
			"settings": {
				"foreground": "#D8D8D8",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid.illegal",
			"settings": {
				"foreground": "#D8D8D8",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "invalid.unimplemented",
			"settings": {
				"foreground": "#D8D8D8",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "carriage-return",
			"settings": {
				"foreground": "#D8D8D8",
				"background": "#282828",
				"fontStyle": "italic underline",
				"content": "^M"
			}
		},
		{
			"scope": "message.error",
			"settings": {
				"foreground": "#D8D8D8"
			}
		},
		{
			"scope": "string variable",
			"settings": {
				"foreground": "#D8D8D8"
			}
		},
		{
			"scope": [
